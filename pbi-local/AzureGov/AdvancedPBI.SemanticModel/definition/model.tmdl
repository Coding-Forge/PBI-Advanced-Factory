model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["fn_DimDate","DimDate","raw_SalesFlat","BridgeCustomerSegment","FactTargets","FactSales","DimCustomer","DimProduct","DimTerritory","DimOrderDate","DimShipDate","DimSegment","DimProductCategory","orders-2026-01","orders-2026-02","orders-2026-03","product-category-map","stg_OrdersCombined","RawDataBaseUrl","RangeStart","RangeEnd","FactOrders","fn_CleanText","SourceFolderPath","EnvironmentName","err_OrdersReview","Metric Parameter","Margin Target","SecurityUserTerritory"]

annotation PBI_ProTooling = ["DevMode","CalcGroup"]

ref table BridgeCustomerSegment
ref table FactTargets
ref table FactSales
ref table DimCustomer
ref table DimProduct
ref table DimTerritory
ref table DimOrderDate
ref table DimShipDate
ref table DimSegment
ref table DimProductCategory
ref table _Measures
ref table 'Time Calculation'
ref table product-category-map
ref table FactOrders
ref table 'Metric Parameter'
ref table 'PBI Field Parameters'
ref table 'Margin Target'
ref table 'Margin Adjustment %'
ref table SecurityUserTerritory
ref table Time_Cal

ref role 'East Region'
ref role 'Dynamic Territory Security'

ref cultureInfo en-US

