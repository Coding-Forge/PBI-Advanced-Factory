            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Sales YoY %"
                }
              },
              "queryRef": "_Measures.Sales YoY %",
              "nativeQueryRef": "Sales YoY %"
            }
          ]
