            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Sales Prior Year"
                }
              },
              "queryRef": "_Measures.Sales Prior Year",
