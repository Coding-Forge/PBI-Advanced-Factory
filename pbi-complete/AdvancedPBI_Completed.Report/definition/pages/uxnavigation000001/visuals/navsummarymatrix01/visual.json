              "nativeQueryRef": "Product Category",
              "active": true
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Sales Amount"
                }
              },
              "queryRef": "_Measures.Sales Amount",
              "nativeQueryRef": "Sales Amount"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Sales Variance %"
                }
              },
              "queryRef": "_Measures.Sales Variance %",
              "nativeQueryRef": "Sales Variance %"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
