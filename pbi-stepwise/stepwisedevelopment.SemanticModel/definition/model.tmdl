model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","CalcGroup"]

annotation PBI_QueryOrder = ["fn_DimDate","DimDate","raw_SalesFlat","FactSales","DimCustomer","DimProduct","DimProductCategory","DimTerritory","FactTargets","BridgeCustomerSegment","DimSegment","DimOrderDate","DimShipDate","Metric Selector","Metric Parameter","Margin Target","RawDataBaseUrl","RangeStart","RangeEnd","SourceFolderPath","EnvironmentName","orders-2026-01","orders-2026-02","orders-2026-03","stg_OrdersCombined","fn_CleanText","err_OrdersReview","FactOrders","product-category-map"]

ref table FactSales
ref table DimCustomer
ref table DimProduct
ref table DimProductCategory
ref table DimTerritory
ref table FactTargets
ref table BridgeCustomerSegment
ref table DimSegment
ref table _Measures
ref table DimOrderDate
ref table DimShipDate
ref table 'Metric Selector'
ref table 'Metric Parameter'
ref table 'Margin Target'
ref table 'Time Intelligence'
ref table FactOrders
ref table product-category-map

ref cultureInfo en-US

