model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["fn_DimDate","DimDate","raw_SalesFlat","FactSales","DimCustomer","DimProduct","DimProductCategory","DimTerritory","FactTargets","BridgeCustomerSegment","DimSegment","DimOrderDate","DimShipDate"]

ref table FactSales
ref table DimCustomer
ref table DimProduct
ref table DimProductCategory
ref table DimTerritory
ref table FactTargets
ref table BridgeCustomerSegment
ref table DimSegment
ref table _Measures
ref table DimOrderDate
ref table DimShipDate

ref cultureInfo en-US

