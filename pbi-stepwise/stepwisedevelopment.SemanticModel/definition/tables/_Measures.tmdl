table _Measures
	lineageTag: 4a2b6c8d-1e3f-4a5b-9c7d-8e0f1a2b3c4d

	measure 'Sales Amount' = SUM ( FactSales[SalesAmount] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 5b3c7d9e-2f4a-4b6c-8d1e-9f2a3b4c5d6e

	measure 'Gross Margin' = SUM ( FactSales[GrossMargin] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 6c4d8e0f-3a5b-4c7d-9e2f-1a3b4c5d6e7f

	measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Sales Amount] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7d5e9f1a-4b6c-4d8e-af3a-2b4c5d6e7f8a

	measure 'Order Count' = DISTINCTCOUNT ( FactSales[SalesOrderLineKey] )
		formatString: #,0
		lineageTag: 8e6f0a2b-5c7d-4e9f-b04b-3c5d6e7f8a9b

	measure 'Target Sales Amount' = SUM ( FactTargets[TargetSalesAmount] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 9f7a1b3c-6d8e-4f0a-c15c-4d6e7f8a9b0c

	measure 'Sales by Order Date' = CALCULATE ( [Sales Amount], DimOrderDate )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: a1b2c3d4-7e9f-4a1b-d26d-5e7f8a9b0c1d

	measure 'Sales by Ship Date' = CALCULATE ( [Sales Amount], DimShipDate )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: b2c3d4e5-8f0a-4b2c-e37e-6f8a9b0c1d2e

	measure Quantity = SUM ( FactSales[Quantity] )
		formatString: #,0
		lineageTag: c3d4e5f6-9a1b-4c3d-f489-7a9b0c1d2e3f

	measure 'Sales Amount (All Products)' = CALCULATE ( [Sales Amount], ALL ( DimProduct ) )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: d4e5f6a7-0b2c-4d4e-a59a-8b0c1d2e3f4a

	measure 'Product Sales Share %' = DIVIDE ( [Sales Amount], [Sales Amount (All Products)] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e5f6a7b8-1c3d-4e5f-b6ab-9c1d2e3f4a5b

	measure 'Sales Amount (Enterprise Only, Keep Filters)' = CALCULATE ( [Sales Amount], KEEPFILTERS ( DimCustomer[CustomerType] = "Enterprise" ) )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: f6a7b8c9-2d4e-4f6a-c7bc-0d2e3f4a5b6c

	measure 'Sales YTD' = TOTALYTD ( [Sales Amount], DimOrderDate[Date] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: a7b8c9d0-3e5f-4a7b-d8cd-1e3f4a5b6c7d

	measure 'Sales Prior Year' = CALCULATE ( [Sales Amount], SAMEPERIODLASTYEAR ( DimOrderDate[Date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: b8c9d0e1-4f6a-4b8c-e9de-2f4a5b6c7d8e

	measure 'Sales YoY' = [Sales Amount] - [Sales Prior Year]
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: c9d0e1f2-5a7b-4c9d-fa0f-3a5b6c7d8e9f

	measure 'Sales YoY %' = DIVIDE ( [Sales YoY], [Sales Prior Year] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d0e1f2a3-6b8c-4d0e-ab1a-4b6c7d8e9f0a

	measure 'Sales Rolling 90 Days' =
			VAR LastVisibleDate =
			    MAX ( DimOrderDate[Date] )
			RETURN
			    CALCULATE (
			        [Sales Amount],
			        DATESINPERIOD ( DimOrderDate[Date], LastVisibleDate, -90, DAY )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: e1f2a3b4-7c9d-4e1f-bc2b-5c7d8e9f0a1b

	measure 'Target Sales Amount (Ending Balance)' =
			// Semi-additive pattern (Lab 02, Exercise 4): FactTargets is stored at
			// monthly snapshot grain (one row per territory/category/month), not a
			// transaction fact, so SUM-ing target rows across a multi-month selection
			// double-counts the target. FactTargets has no relationship to a date
			// dimension, so the "current" month is resolved directly from
			// FactTargets[TargetMonth] using its own max date within whatever filter
			// context (e.g. a territory/category slicer) is active.
			VAR LastTargetMonth =
			    CALCULATE ( MAX ( FactTargets[TargetMonth] ), ALLSELECTED ( FactTargets[TargetMonth] ) )
			RETURN
			    CALCULATE (
			        [Target Sales Amount],
			        FactTargets[TargetMonth] = LastTargetMonth
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: f2a3b4c5-8d0e-4f2a-cd3c-6d8e9f0a1b2c

	measure 'Customer Sales Rank' = RANKX ( ALLSELECTED ( DimCustomer[CustomerName] ), [Sales Amount], , DESC, DENSE )
		formatString: #,0
		lineageTag: a3b4c5d6-9e1f-4a3b-de4d-7e9f0a1b2c3d

	measure 'Is Top 5 Customer' = IF ( [Customer Sales Rank] <= 5, 1, 0 )
		formatString: 0
		lineageTag: b4c5d6e7-0f2a-4b4c-ef5e-8f0a1b2c3d4e

	measure 'Selected Territory Or Region' =
			VAR SelectedTerritory = SELECTEDVALUE ( DimTerritory[TerritoryName] )
			VAR SelectedRegion = SELECTEDVALUE ( DimTerritory[TerritoryRegion] )
			RETURN
			    COALESCE ( SelectedTerritory, SelectedRegion, "All Territories" )
		lineageTag: c5d6e7f8-1a3b-4c5d-fa6f-9a1b2c3d4e5f

	measure 'Dynamic Title' = "Sales Overview — " & [Selected Territory Or Region]
		lineageTag: d6e7f8a9-2b4c-4d6e-ab7a-0b2c3d4e5f6a

	measure 'Selected Metric' =
			VAR SelectedMetric = SELECTEDVALUE ( 'Metric Selector'[Metric], "Sales Amount" )
			RETURN
			    SWITCH (
			        SelectedMetric,
			        "Sales Amount", [Sales Amount],
			        "Gross Margin", [Gross Margin],
			        "Gross Margin %", [Gross Margin %],
			        "Quantity", [Quantity],
			        [Sales Amount]
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: f8a9b0c1-4c5d-4f8a-cd9c-2c4d5e6f7a8b

	measure 'Margin Health Score (Unoptimized)' =
			// Lab 02, Exercise 8: deliberately repeats the same CALCULATE/ALL and
			// DIVIDE logic three times instead of branching from existing measures.
			// Each repeated sub-expression re-evaluates the full filter context,
			// which costs more and is harder to maintain than the optimized version.
			IF (
			    DIVIDE ( SUM ( FactSales[GrossMargin] ), SUM ( FactSales[SalesAmount] ) ) >= 0.4,
			    "Healthy",
			    IF (
			        DIVIDE ( SUM ( FactSales[GrossMargin] ), SUM ( FactSales[SalesAmount] ) ) >= 0.25,
			        "Watch",
			        IF (
			            DIVIDE ( SUM ( FactSales[GrossMargin] ), CALCULATE ( SUM ( FactSales[SalesAmount] ), ALL ( FactSales ) ) ) >= 0,
			            "At Risk",
			            "At Risk"
			        )
			    )
			)
		lineageTag: a9b0c1d2-5d6e-4a9b-de0d-3d5e6f7a8b9c

	measure 'Margin Health Score' =
			// Optimized: computes Gross Margin % once via a variable and branches
			// from the trusted base measure instead of re-deriving SUM/DIVIDE logic
			// in every branch. Easier to read, test, and reuse.
			VAR MarginPct = [Gross Margin %]
			RETURN
			    SWITCH (
			        TRUE (),
			        MarginPct >= 0.4, "Healthy",
			        MarginPct >= 0.25, "Watch",
			        "At Risk"
			    )
		lineageTag: b0c1d2e3-6e7f-4b0c-ef1e-4e6f7a8b9c0d

	column Value
		lineageTag: 128e770a-5a8d-4084-b873-bfc8feb87ecc
		isNameInferred
		sourceColumn: [Value]

	partition _Measures = calculated
		mode: import
		source = {(1)}

	annotation PBI_Id = 3f8a6b2c9d4e4f5a8b7c6d5e4f3a2b1c

