table _Measures
	lineageTag: 4a2b6c8d-1e3f-4a5b-9c7d-8e0f1a2b3c4d

	measure 'Sales Amount' = SUM ( FactSales[SalesAmount] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 5b3c7d9e-2f4a-4b6c-8d1e-9f2a3b4c5d6e

	measure 'Gross Margin' = SUM ( FactSales[GrossMargin] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 6c4d8e0f-3a5b-4c7d-9e2f-1a3b4c5d6e7f

	measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Sales Amount] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7d5e9f1a-4b6c-4d8e-af3a-2b4c5d6e7f8a

	measure 'Order Count' = DISTINCTCOUNT ( FactSales[SalesOrderLineKey] )
		formatString: #,0
		lineageTag: 8e6f0a2b-5c7d-4e9f-b04b-3c5d6e7f8a9b

	measure 'Target Sales Amount' = SUM ( FactTargets[TargetSalesAmount] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 9f7a1b3c-6d8e-4f0a-c15c-4d6e7f8a9b0c

	measure 'Sales by Order Date' = CALCULATE ( [Sales Amount], DimOrderDate )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: a1b2c3d4-7e9f-4a1b-d26d-5e7f8a9b0c1d

	measure 'Sales by Ship Date' = CALCULATE ( [Sales Amount], DimShipDate )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: b2c3d4e5-8f0a-4b2c-e37e-6f8a9b0c1d2e

	measure Quantity = SUM ( FactSales[Quantity] )
		formatString: #,0
		lineageTag: c3d4e5f6-9a1b-4c3d-f489-7a9b0c1d2e3f

	measure 'Sales Amount (All Products)' = CALCULATE ( [Sales Amount], ALL ( DimProduct ) )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: d4e5f6a7-0b2c-4d4e-a59a-8b0c1d2e3f4a

	measure 'Product Sales Share %' = DIVIDE ( [Sales Amount], [Sales Amount (All Products)] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e5f6a7b8-1c3d-4e5f-b6ab-9c1d2e3f4a5b

	measure 'Sales Amount (Enterprise Only, Keep Filters)' = CALCULATE ( [Sales Amount], KEEPFILTERS ( DimCustomer[CustomerType] = "Enterprise" ) )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: f6a7b8c9-2d4e-4f6a-c7bc-0d2e3f4a5b6c

	column Value
		lineageTag: 128e770a-5a8d-4084-b873-bfc8feb87ecc
		isNameInferred
		sourceColumn: [Value]

	partition _Measures = calculated
		mode: import
		source = {(1)}

	annotation PBI_Id = 3f8a6b2c9d4e4f5a8b7c6d5e4f3a2b1c

