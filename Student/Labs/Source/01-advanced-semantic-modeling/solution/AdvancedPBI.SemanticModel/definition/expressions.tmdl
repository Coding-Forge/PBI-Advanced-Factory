	annotation PBI_ResultType = Table

expression DimDate =
		let
		    Source = fn_DimDate(#date(2023, 1, 1), #date(2029, 12, 31), 7, null)
		in
		    Source
	lineageTag: c3462345-aad4-4801-99d0-cdee9d354bc3

