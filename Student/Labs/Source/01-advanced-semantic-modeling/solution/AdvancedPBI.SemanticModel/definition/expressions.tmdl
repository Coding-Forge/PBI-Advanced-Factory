		  Source = Csv.Document(File.Contents("C:\Projects\PowerBI\workshop\PBI_AdvancedFactory\data\sales-flat.csv"), [Delimiter = ",", Columns = 21, QuoteStyle = QuoteStyle.None]),
		  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
